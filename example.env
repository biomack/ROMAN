# ================================================================
# Agent Skills — Configuration (CLI mode)
# ================================================================

# Provider: openai-compatible (LM Studio, OpenAI, OpenRouter, vLLM, etc.)
LLM_PROVIDER=openai

# --- OpenAI-compatible settings (LM Studio, OpenRouter, etc.) ---
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_MODEL= openai/gpt-oss-20b
OPENAI_API_KEY=lm-studio
OPENAI_TIMEOUT_SECONDS=1200

# --- General ---
LLM_TEMPERATURE=0.4
SKILLS_DIR=skills

# --- Sessions ---
SESSION_TTL_SECONDS=3600
SESSION_MAX_MESSAGES=100
REFERENCE_FILE_MAX_BYTES=32768
REFERENCE_FILES_TOTAL_MAX_BYTES=262144

# --- Mattermost bot (--mode bot) ---
#MATTERMOST_URL=im.example.com
#MATTERMOST_TOKEN=your_personal_access_token
#MATTERMOST_TEAM=your_team
#MATTERMOST_CHANNEL=your_channel
#MATTERMOST_BOT_NAME=your_bot_name
#MATTERMOST_THREAD_HISTORY_DEPTH=20

# --- NetBox MCP (used by: netbox skill) ---
NETBOX_MCP_URL=http://localhost:8000/mcp
NETBOX_LLM_URL=http://172.16.92.9:1234/v1/
NETBOX_LLM_MODEL=qwen/qwen3.5-35b-a3b
# Protection from tool loops:
NETBOX_MAX_TOOL_ROUNDS=20
NETBOX_MAX_IDENTICAL_TOOL_CALLS=3

# --- Direct VictoriaMetrics/VictoriaLogs HTTP endpoints ---
# Used by: victoriametrics_query, victorialogs_query
VM_METRICS_URL=http://vmselect-xaas-mon-vmcluster:8481/select/0/prometheus
VM_LOGS_URL=http://vlsingle-vlogs-ha.victorialogs.svc:9428
VM_AUTH_HEADER=
VM_TIMEOUT_SECONDS=20

# VictoriaMetrics instance settings (for docker-compose)
VM_INSTANCE_ENTRYPOINT=https://play.victoriametrics.com
VM_INSTANCE_TYPE=cluster

# VictoriaLogs instance settings (for docker-compose)
VL_INSTANCE_ENTRYPOINT=http://victorialogs:9428
