<mxfile host="app.diagrams.net">
  <diagram name="ROMAN User Flow" id="roman-system-flow-01">
    <mxGraphModel dx="1280" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="ROMAN: общая блок-схема работы системы" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="520" height="30" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Пользовательский сценарий: от запроса до ответа" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="420" height="24" as="geometry" />
        </mxCell>

        <mxCell id="start" value="Пользователь отправляет&#xa;вопрос или команду" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="610" y="100" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="entry" value="Точка входа&#xa;CLI или Mattermost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="610" y="220" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="session" value="Агент получает запрос&#xa;и поднимает сессию" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="610" y="340" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="context" value="Собирается контекст:&#xa;история диалога, правила,&#xa;доступные скиллы и инструменты" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="580" y="460" width="280" height="100" as="geometry" />
        </mxCell>

        <mxCell id="llm" value="Агент отправляет запрос&#xa;в LLM вместе с контекстом" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="600" y="610" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="decision_tools" value="Нужны ли&#xa;дополнительные действия&#xa;или проверки?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="620" y="740" width="200" height="120" as="geometry" />
        </mxCell>

        <mxCell id="final_direct" value="LLM формирует&#xa;готовый ответ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="970" y="760" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="decision_skill" value="Нужный скилл&#xa;уже загружен?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="250" y="740" width="190" height="120" as="geometry" />
        </mxCell>

        <mxCell id="load_skill" value="Агент загружает&#xa;подходящий скилл" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="80" y="760" width="150" height="80" as="geometry" />
        </mxCell>

        <mxCell id="execute_tool" value="Агент запускает&#xa;инструмент / действие" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="260" y="920" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="external" value="Внешние системы:&#xa;API, серверы, Kubernetes,&#xa;Mattermost и др." style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="230" y="1060" width="280" height="110" as="geometry" />
        </mxCell>

        <mxCell id="tool_result" value="Результат действия&#xa;возвращается агенту" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="590" y="1065" width="260" height="100" as="geometry" />
        </mxCell>

        <mxCell id="llm_after_tool" value="Агент передает результат&#xa;обратно в LLM для&#xa;сборки итогового ответа" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="940" y="1065" width="280" height="100" as="geometry" />
        </mxCell>

        <mxCell id="save" value="Ответ сохраняется&#xa;в сессию" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="970" y="900" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="reply" value="Ответ возвращается&#xa;в CLI или Mattermost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="970" y="610" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="end" value="Пользователь получает&#xa;итоговый результат" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="970" y="480" width="220" height="80" as="geometry" />
        </mxCell>

